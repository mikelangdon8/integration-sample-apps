<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <caching enabled="true" enableKernelCache="false">
      <profiles>
        <add extension=".aspx" policy="CacheForTimePeriod" kernelCachePolicy="DontCache" duration="00:00:30" />
      </profiles>
    </caching>
  </system.webServer>
  <location path="slow.aspx">
    <system.webServer>
      <caching enabled="false" />
    </system.webServer>
  </location>
</configuration>
